# Sleepers Researcher — copy to .env and fill in. NEVER commit .env.

# --- LLM providers ---
# Google Gemini API key (model: gemini-3.1-flash-lite-preview)
GEMINI_API_KEY=
# Groq API key (OpenAI-compatible endpoint)
GROQ_API_KEY=

# Model overrides (optional — sensible defaults baked in)
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GROQ_MODEL=llama-3.3-70b-versatile

# --- Router ---
# Which backend handles requests by default: "gemini" (heavy reasoning) or "groq" (fast/cheap)
DEFAULT_BACKEND=gemini

# --- Tools ---
# Tavily web search API key (https://tavily.com). Leave blank to disable web search.
TAVILY_API_KEY=

# --- Memory ---
# Embedding provider for the vector store. Currently uses Gemini embeddings (reuses GEMINI_API_KEY).
EMBEDDING_MODEL=text-embedding-004
